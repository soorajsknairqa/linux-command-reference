#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════════
#  Linux Commands Reference — self-contained executable for Fedora Linux
#  chmod +x linux-commands-reference && ./linux-commands-reference
# ══════════════════════════════════════════════════════════════════════════════

APP_DIR="$(mktemp -d /tmp/linux-ref-XXXXXX)"
cleanup() { rm -rf "$APP_DIR"; }
trap cleanup EXIT

echo ""
echo "  ┌─────────────────────────────────────┐"
echo "  │   Linux Commands Reference          │"
echo "  │   GTK4 desktop app · 127 commands   │"
echo "  └─────────────────────────────────────┘"
echo ""

# ── Check Python3 ─────────────────────────────────────────────────────────────
if ! command -v python3 &>/dev/null; then
    echo "  ✗  python3 not found. Install: sudo dnf install python3"
    exit 1
fi

# ── Check GTK4 + Libadwaita ───────────────────────────────────────────────────
if ! python3 -c "
import gi
gi.require_version('Gtk','4.0')
gi.require_version('Adw','1')
from gi.repository import Gtk, Adw
" 2>/dev/null; then
    echo "  ⚙  GTK4 / Libadwaita Python bindings not found."
    echo "     Installing now (sudo password may be required)..."
    echo ""
    sudo dnf install -y python3-gobject gtk4 libadwaita || {
        echo ""
        echo "  ✗  Installation failed. Please run manually:"
        echo "     sudo dnf install python3-gobject gtk4 libadwaita"
        exit 1
    }
    echo ""
fi

echo "  ✓  Dependencies OK"

# ── Extract embedded app ──────────────────────────────────────────────────────
python3 - "$APP_DIR" << 'PYEOF'
import sys, base64, os

app_dir = sys.argv[1]

MAIN_B64 = ""

DATA_B64 = ""

with open(os.path.join(app_dir, 'main.py'), 'wb') as f:
    f.write(base64.b64decode(MAIN_B64))

with open(os.path.join(app_dir, 'commands_data.json'), 'wb') as f:
    f.write(base64.b64decode(DATA_B64))
PYEOF

echo "  ▶  Launching..."
echo ""
exec python3 "$APP_DIR/main.py"
